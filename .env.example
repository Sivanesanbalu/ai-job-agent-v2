# AI Job Agent V2 — Production Environment Configuration
APP_NAME="AI Job Agent SaaS"
APP_ENV="production"
DEBUG=false
VERSION="2.0.0"

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_job_agent"
SQLITE_FALLBACK_URL="sqlite:///jobs_v2.db"

# Redis Cache & Background Tasks
REDIS_URL="redis://localhost:6379/0"

# Security & JWT Secrets (Change in Production!)
SECRET_KEY="generate-a-secure-random-64-character-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Multi-Tenant File Storage Paths
UPLOAD_DIR="./data/uploads"
RESUME_STORAGE_DIR="./data/resumes"
BROWSER_DATA_DIR="./data/browser_sessions"

# Local AI / LLM (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3"

# Frontend CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Billing & Credits
FREE_SIGNUP_CREDITS=100
CREDIT_PRICE_PER_100_INR=100
